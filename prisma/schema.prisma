// PayCore — Full Prisma Schema
// See: PayCore_Build_Prompt.md Section 4 (Database Schema)
// All UUIDs for external-facing IDs (prevents enumeration)
// All business tables have createdAt, updatedAt, and soft-delete deletedAt
// Indexes on all FKs and columns used in filters

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────

enum UserRole {
  ADMIN
  HR_PAYROLL_MANAGER
  HR_PAYROLL_USER
  HR_MANAGER
  EMPLOYEE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REFUSE
  COMPUTE
  VALIDATE
  MARK_PAID
  SEND
  LOGIN_FAILED
  PASSWORD_RESET
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum EmployeeType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum ContractStatus {
  DRAFT
  RUNNING
  EXPIRED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  MISSING_CHECKOUT
  MANUALLY_CORRECTED
  ON_LEAVE
}

enum AttendanceSource {
  WIDGET
  MANUAL
  IMPORTED
}

enum TimeOffUnit {
  DAYS
  HOURS
}

enum AllocationStatus {
  PENDING_APPROVAL
  APPROVED
  EXPIRED
  REFUSED
}

enum TimeOffRequestStatus {
  TO_APPROVE
  APPROVED
  REFUSED
  CANCELLED
}

enum SalaryRuleCategory {
  BASIC
  ALLOWANCE
  GROSS
  DEDUCTION
  EMPLOYER_CONTRIBUTION
  NET
}

enum ComputationMethod {
  FIXED_AMOUNT
  PERCENTAGE_OF_RULE
  FORMULA
}

enum PayrunStatus {
  DRAFT
  COMPUTED
  VALIDATED
  PAID
  CANCELLED
}

enum PayslipStatus {
  DRAFT
  COMPUTED
  VALIDATED
  PAID
  CANCELLED
}

enum PayslipWarningType {
  MISSING_BANK_DETAILS
  DUPLICATE_PAYSLIP
  MISSING_CONTRACT
  NEGATIVE_NET_PAY
  MISSING_WORKING_SCHEDULE
  OTHER
}

enum ScheduleStatus {
  ACTIVE
  ARCHIVED
}

enum StructureStatus {
  ACTIVE
  ARCHIVED
}

enum TimeOffTypeStatus {
  ACTIVE
  ARCHIVED
}

// ──────────────────────────────────────────────
// 4.1 IDENTITY & ACCESS
// ──────────────────────────────────────────────

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  firstName         String
  lastName          String
  phone             String?
  avatarUrl         String?
  role              UserRole  @default(EMPLOYEE)
  isActive          Boolean   @default(true)
  mustChangePassword Boolean  @default(false)
  employeeId        String?   @unique
  employee          Employee? @relation(fields: [employeeId], references: [id])
  lastLoginAt       DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs          AuditLog[]            @relation("AuditActor")
  createdPayruns     Payrun[]              @relation("PayrunCreator")
  validatedPayruns   Payrun[]              @relation("PayrunValidator")

  @@index([role])
  @@index([isActive])
  @@index([email])
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdByIp String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model AuditLog {
  id           String      @id @default(uuid())
  actorUserId  String?
  actor        User?       @relation("AuditActor", fields: [actorUserId], references: [id])
  entityType   String      // e.g. "User", "Contract", "Payrun"
  entityId     String
  action       AuditAction
  beforeJson   String?     @db.Text // JSON string of previous state
  afterJson    String?     @db.Text // JSON string of new state
  ipAddress    String?
  userAgent    String?

  createdAt DateTime @default(now())

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// ──────────────────────────────────────────────
// 4.2 COMPANY / ORG STRUCTURE
// ──────────────────────────────────────────────

model Company {
  id        String  @id @default(uuid())
  name      String
  legalName String?
  timezone  String  @default("Asia/Kolkata")
  currency  String  @default("INR")
  logoUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  departments      Department[]
  jobPositions     JobPosition[]
  employees        Employee[]
  workingSchedules WorkingSchedule[]
  salaryStructures SalaryStructure[]
  payruns          Payrun[]
  timeOffTypes     TimeOffType[]
}

model Department {
  id                  String  @id @default(uuid())
  companyId           String
  company             Company @relation(fields: [companyId], references: [id])
  name                String
  parentDepartmentId  String?
  parentDepartment    Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  childDepartments    Department[] @relation("DepartmentHierarchy")
  managerEmployeeId   String?
  managerEmployee     Employee?    @relation("DepartmentManager", fields: [managerEmployeeId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  employees    Employee[]    @relation("EmployeeDepartment")
  contracts    Contract[]
  jobPositions JobPosition[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([parentDepartmentId])
  @@index([managerEmployeeId])
}

model JobPosition {
  id           String  @id @default(uuid())
  companyId    String
  company      Company @relation(fields: [companyId], references: [id])
  title        String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  employees Employee[]
  contracts Contract[]

  @@index([companyId])
  @@index([departmentId])
}

// ──────────────────────────────────────────────
// 4.3 EMPLOYEE & CONTRACT
// ──────────────────────────────────────────────

model Employee {
  id                       String         @id @default(uuid())
  companyId                String
  company                  Company        @relation(fields: [companyId], references: [id])
  employeeCode             String         @unique // e.g. EMP/2026/0048
  firstName                String
  lastName                 String
  workEmail                String         @unique
  personalEmail            String?
  phone                    String?
  dateOfBirth              DateTime?
  dateOfJoining            DateTime
  departmentId             String
  department               Department     @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  jobPositionId            String
  jobPosition              JobPosition    @relation(fields: [jobPositionId], references: [id])
  managerId                String?
  manager                  Employee?      @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports            Employee[]     @relation("EmployeeManager")
  workingScheduleId        String?
  workingSchedule          WorkingSchedule? @relation(fields: [workingScheduleId], references: [id])
  status                   EmployeeStatus @default(ACTIVE)
  employeeType             EmployeeType   @default(FULL_TIME)
  workLocation             String?
  // Encrypted fields — stored as ciphertext (AES-256-GCM via lib/security/crypto.ts)
  bankAccountNumberEncrypted String?
  bankIfscEncrypted        String?
  bankVerified             Boolean        @default(false)
  panEncrypted             String?
  avatarColor              String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  user               User?
  contracts          Contract[]
  attendanceRecords  AttendanceRecord[]
  timeOffAllocations TimeOffAllocation[]
  timeOffRequests    TimeOffRequest[]
  payslips           Payslip[]
  managedDepartments Department[]        @relation("DepartmentManager")

  @@index([companyId])
  @@index([departmentId])
  @@index([jobPositionId])
  @@index([managerId])
  @@index([workingScheduleId])
  @@index([status])
  @@index([employeeType])
  @@index([workEmail])
}

model Contract {
  id                String          @id @default(uuid())
  employeeId        String
  employee          Employee        @relation(fields: [employeeId], references: [id])
  contractNumber    String          @unique // e.g. CON/2026/0042
  departmentId      String
  department        Department      @relation(fields: [departmentId], references: [id])
  jobPositionId     String
  jobPosition       JobPosition     @relation(fields: [jobPositionId], references: [id])
  salaryStructureId String
  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id])
  wagePerMonth      Decimal         @db.Decimal(12, 2)
  startDate         DateTime
  endDate           DateTime?       // null = open-ended/running
  status            ContractStatus  @default(DRAFT)
  workingScheduleId String?
  workingSchedule   WorkingSchedule? @relation(fields: [workingScheduleId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  payslips Payslip[]

  // NOTE: Contract overlap constraint (EXCLUDE USING gist) will be added
  // via a raw SQL migration in Milestone 2. See docs/decisions.md.
  // Prisma doesn't support exclusion constraints natively.

  @@index([employeeId])
  @@index([departmentId])
  @@index([jobPositionId])
  @@index([salaryStructureId])
  @@index([status])
  @@index([startDate, endDate])
}

// ──────────────────────────────────────────────
// 4.4 WORKING SCHEDULE
// ──────────────────────────────────────────────

model WorkingSchedule {
  id        String         @id @default(uuid())
  companyId String
  company   Company        @relation(fields: [companyId], references: [id])
  name      String         // e.g. "India — Standard 40h"
  timezone  String         @default("Asia/Kolkata")
  isDefault Boolean        @default(false)
  status    ScheduleStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  slots             WorkingScheduleSlot[]
  employees         Employee[]
  contracts         Contract[]
  attendanceRecords AttendanceRecord[]

  @@index([companyId])
  @@index([status])
}

model WorkingScheduleSlot {
  id                String          @id @default(uuid())
  workingScheduleId String
  workingSchedule   WorkingSchedule @relation(fields: [workingScheduleId], references: [id], onDelete: Cascade)
  dayOfWeek         Int             // 0=Sun, 1=Mon, ..., 6=Sat
  startTime         String          // HH:mm format
  endTime           String          // HH:mm format
  breakMinutes      Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workingScheduleId])
}

// ──────────────────────────────────────────────
// 4.5 ATTENDANCE
// ──────────────────────────────────────────────

model AttendanceRecord {
  id                String            @id @default(uuid())
  employeeId        String
  employee          Employee          @relation(fields: [employeeId], references: [id])
  workingScheduleId String?
  workingSchedule   WorkingSchedule?  @relation(fields: [workingScheduleId], references: [id])
  checkIn           DateTime
  checkOut          DateTime?         // null while still checked in
  workedMinutes     Int?              // computed on checkout
  status            AttendanceStatus  @default(PRESENT)
  source            AttendanceSource  @default(WIDGET)
  correctedByUserId String?
  correctionReason  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([employeeId, checkIn])
  @@index([employeeId])
  @@index([status])
  @@index([checkIn])
}

// ──────────────────────────────────────────────
// 4.6 TIME OFF
// ──────────────────────────────────────────────

model TimeOffType {
  id                 String           @id @default(uuid())
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id])
  name               String           // e.g. "Earned Leave", "Sick Leave"
  unit               TimeOffUnit      @default(DAYS)
  requiresAllocation Boolean          @default(true)
  requiresApproval   Boolean          @default(true)
  affectsPayroll     Boolean          @default(true)
  colorTag           String?
  status             TimeOffTypeStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  allocations TimeOffAllocation[]
  requests    TimeOffRequest[]

  @@index([companyId])
  @@index([status])
}

model TimeOffAllocation {
  id              String           @id @default(uuid())
  employeeId      String
  employee        Employee         @relation(fields: [employeeId], references: [id])
  timeOffTypeId   String
  timeOffType     TimeOffType      @relation(fields: [timeOffTypeId], references: [id])
  allocatedAmount Decimal          @db.Decimal(6, 2)
  takenAmount     Decimal          @default(0) @db.Decimal(6, 2) // denormalized, kept in sync via transaction
  // remainingAmount computed as allocatedAmount - takenAmount (application-level)
  validFrom       DateTime
  validTo         DateTime?
  status          AllocationStatus @default(PENDING_APPROVAL)
  approvedByUserId String?
  approvedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  requests TimeOffRequest[]

  @@index([employeeId])
  @@index([timeOffTypeId])
  @@index([status])
  @@index([employeeId, timeOffTypeId])
}

model TimeOffRequest {
  id              String               @id @default(uuid())
  employeeId      String
  employee        Employee             @relation(fields: [employeeId], references: [id])
  timeOffTypeId   String
  timeOffType     TimeOffType          @relation(fields: [timeOffTypeId], references: [id])
  allocationId    String?              // resolved at approval time if type requires allocation
  allocation      TimeOffAllocation?   @relation(fields: [allocationId], references: [id])
  startDate       DateTime
  endDate         DateTime
  durationAmount  Decimal              @db.Decimal(6, 2) // days or hours
  unpaidDays      Decimal              @default(0) @db.Decimal(6, 2)
  reason          String?
  status          TimeOffRequestStatus @default(TO_APPROVE)
  decidedByUserId String?
  decidedAt       DateTime?
  decisionNote    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([timeOffTypeId])
  @@index([allocationId])
  @@index([status])
  @@index([startDate, endDate])
}

// ──────────────────────────────────────────────
// 4.7 SALARY STRUCTURES & RULES
// ──────────────────────────────────────────────

model SalaryStructure {
  id          String          @id @default(uuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id])
  name        String          // e.g. "Regular Salary"
  description String?
  status      StructureStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  rules     SalaryRule[]
  contracts Contract[]
  payruns   Payrun[]
  payslips  Payslip[]

  @@index([companyId])
  @@index([status])
}

model SalaryRule {
  id                   String             @id @default(uuid())
  salaryStructureId    String
  salaryStructure      SalaryStructure    @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)
  name                 String             // e.g. "Basic Salary"
  code                 String             // e.g. "BASIC", "HRA", "PF"
  category             SalaryRuleCategory
  sequence             Int                // execution + display order
  computationMethod    ComputationMethod
  fixedAmount          Decimal?           @db.Decimal(12, 2)
  percentageOfRuleCode String?            // the code of the rule this is a % of
  percentageValue      Decimal?           @db.Decimal(8, 4)
  formulaExpression    String?            // sandboxed expression
  appearsOnPayslip     Boolean            @default(true)
  active               Boolean            @default(true)
  isProrated           Boolean            @default(true) // pro-rate by WORKED_DAYS/TOTAL_WORKING_DAYS

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  payslipLines PayslipLine[]

  @@unique([salaryStructureId, code])
  @@index([salaryStructureId])
  @@index([sequence])
}

// ──────────────────────────────────────────────
// 4.8 PAYROLL RUNS & PAYSLIPS
// ──────────────────────────────────────────────

model Payrun {
  id                  String       @id @default(uuid())
  companyId           String
  company             Company      @relation(fields: [companyId], references: [id])
  name                String       // e.g. "September 2026 monthly payroll"
  employeeTypeScope   String       @default("ALL") // ALL, FULL_TIME, PART_TIME, CONTRACT — stored as string for flexibility
  salaryStructureId   String
  salaryStructure     SalaryStructure @relation(fields: [salaryStructureId], references: [id])
  periodStart         DateTime
  periodEnd           DateTime
  status              PayrunStatus @default(DRAFT)
  createdByUserId     String
  createdByUser       User         @relation("PayrunCreator", fields: [createdByUserId], references: [id])
  computedAt          DateTime?
  validatedByUserId   String?
  validatedByUser     User?        @relation("PayrunValidator", fields: [validatedByUserId], references: [id])
  validatedAt         DateTime?
  paidAt              DateTime?
  sentPayslipsAt      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  payslips Payslip[]

  @@index([companyId])
  @@index([salaryStructureId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@index([createdByUserId])
}

model Payslip {
  id                String        @id @default(uuid())
  payrunId          String
  payrun            Payrun        @relation(fields: [payrunId], references: [id])
  employeeId        String
  employee          Employee      @relation(fields: [employeeId], references: [id])
  contractId        String
  contract          Contract      @relation(fields: [contractId], references: [id])
  salaryStructureId String
  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id])
  periodStart       DateTime
  periodEnd         DateTime
  workedDays        Decimal       @default(0) @db.Decimal(6, 2)
  totalWorkingDays  Decimal       @default(0) @db.Decimal(6, 2)
  unpaidLeaveDays   Decimal       @default(0) @db.Decimal(6, 2)
  overtimeHours     Decimal       @default(0) @db.Decimal(6, 2)
  status            PayslipStatus @default(DRAFT)
  grossAmount       Decimal       @default(0) @db.Decimal(12, 2)
  totalDeductions   Decimal       @default(0) @db.Decimal(12, 2)
  netAmount         Decimal       @default(0) @db.Decimal(12, 2)
  hasWarnings       Boolean       @default(false)
  pdfStorageKey     String?
  emailSentAt       DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  lines    PayslipLine[]
  warnings PayslipWarning[]

  @@unique([payrunId, employeeId])
  @@index([payrunId])
  @@index([employeeId])
  @@index([contractId])
  @@index([status])
  @@index([periodStart, periodEnd])
}

model PayslipLine {
  id           String             @id @default(uuid())
  payslipId    String
  payslip      Payslip            @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  salaryRuleId String
  salaryRule   SalaryRule         @relation(fields: [salaryRuleId], references: [id])
  ruleCode     String
  ruleName     String
  category     SalaryRuleCategory
  sequence     Int
  amount       Decimal            @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([payslipId])
  @@index([salaryRuleId])
}

model PayslipWarning {
  id        String             @id @default(uuid())
  payslipId String
  payslip   Payslip            @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  type      PayslipWarningType
  message   String
  resolved  Boolean            @default(false)

  createdAt DateTime @default(now())

  @@index([payslipId])
  @@index([type])
  @@index([resolved])
}
